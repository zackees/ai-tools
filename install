#!/usr/bin/env bash
# Install the soldr binary used by build/lint/test to route Rust toolchain
# calls through `rustup which`. soldr is intentionally NOT a language dep —
# it ships as a standalone binary published to GitHub Releases.
#
# Version policy (float):
#   - --version=X / SOLDR_VERSION=X pins exactly X.
#   - Otherwise, if a soldr is already on PATH, use it (no download).
#   - Otherwise, download the latest soldr release.
#
# Default: install into this repo's .venv/{bin,Scripts}/soldr. Creates the
#          .venv layout (.venv/bin on unix, .venv/Scripts on Windows) on
#          first run so this is a one-stop bootstrap for a fresh clone.
# --global: install into ~/.cargo/bin (or ~/.local/bin if absent).

set -euo pipefail

VERSION="${SOLDR_VERSION:-}"
GLOBAL=0
DRY_RUN=0
LATEST_URL="https://github.com/zackees/soldr/releases/latest"

usage() {
    cat <<EOF2
Usage: ./install [--global] [--version=VERSION] [--dry-run]

Installs soldr (https://github.com/zackees/soldr) — a thin wrapper around
the rustup-managed cargo/rustc/rustfmt that this repo's build scripts
expect on PATH.

Version policy (default: float):
  1. --version / SOLDR_VERSION set  -> install exactly that version.
  2. soldr already on PATH          -> use it; nothing is downloaded.
  3. otherwise                      -> download the latest soldr release.

Options:
  --global              Install to ~/.cargo/bin (or ~/.local/bin) instead
                        of the local .venv. Useful if you work across
                        multiple Rust repos.
  --version=VERSION     Pin an exact soldr version (default: float, see
                        above).
  --dry-run             Print what would happen without downloading or
                        writing anything.
  -h, --help            Show this message.

Environment:
  SOLDR_VERSION         Same as --version.
EOF2
}

for arg in "$@"; do
    case "$arg" in
        --global) GLOBAL=1 ;;
        --version=*) VERSION="${arg#--version=}" ;;
        --dry-run) DRY_RUN=1 ;;
        -h|--help) usage; exit 0 ;;
        *) echo "unknown arg: $arg" >&2; usage >&2; exit 2 ;;
    esac
done

# Resolve the latest soldr release by following the releases/latest redirect
# to .../releases/tag/vX.Y.Z (no API call, so no unauthenticated rate limit).
resolve_latest() {
    local effective tag
    if ! effective=$(curl -fsSLI -o /dev/null -w '%{url_effective}' "$LATEST_URL"); then
        echo "error: could not resolve the latest soldr release from $LATEST_URL" >&2
        echo "       pass --version=X (or SOLDR_VERSION=X) to pin one explicitly." >&2
        return 1
    fi
    tag="${effective##*/}"
    if [[ ! "$tag" =~ ^v[0-9]+\.[0-9]+\.[0-9]+ ]]; then
        echo "error: unexpected latest-release URL: $effective" >&2
        echo "       pass --version=X (or SOLDR_VERSION=X) to pin one explicitly." >&2
        return 1
    fi
    printf '%s\n' "${tag#v}"
}

uname_s=$(uname -s)
uname_m=$(uname -m)

case "$uname_m" in
    x86_64|amd64) arch=x86_64 ;;
    aarch64|arm64) arch=aarch64 ;;
    *) echo "unsupported architecture: $uname_m" >&2; exit 1 ;;
esac

case "$uname_s" in
    Linux*)   triple="${arch}-unknown-linux-gnu"; ext=tar.gz; bin_subdir=bin ;;
    Darwin*)  triple="${arch}-apple-darwin";      ext=tar.gz; bin_subdir=bin ;;
    MINGW*|MSYS*|CYGWIN*|Windows_NT)
              triple="${arch}-pc-windows-msvc";   ext=zip;    bin_subdir=Scripts ;;
    *) echo "unsupported OS: $uname_s" >&2; exit 1 ;;
esac

binary="soldr"
[[ "$ext" == "zip" ]] && binary="soldr.exe"

repo_root="$(cd "$(dirname "$0")" && pwd)"

if (( GLOBAL )); then
    if [[ -d "${HOME}/.cargo/bin" ]]; then
        target_dir="${HOME}/.cargo/bin"
    else
        target_dir="${HOME}/.local/bin"
    fi
else
    # ai-tools is pure-Rust, so unlike clud there is no `uv sync` step that
    # pre-creates .venv. Just create the layout ourselves so `./install` on
    # a fresh clone Just Works without a Python toolchain installed.
    target_dir="${repo_root}/.venv/${bin_subdir}"
fi

if [[ -z "$VERSION" ]]; then
    system_soldr="$(command -v soldr 2>/dev/null || true)"
    # A soldr inside target_dir is the copy this script manages, not a system
    # install: fall through and refresh it to the latest release.
    if [[ -n "$system_soldr" && "$(cd "$(dirname "$system_soldr")" && pwd)" != "$target_dir" ]]; then
        system_version="$("$system_soldr" --version 2>/dev/null || echo 'soldr (version unknown)')"
        echo "Using system soldr: $system_soldr ($system_version)"
        echo "Nothing downloaded. Pass --version=X (or SOLDR_VERSION=X) to install a pinned copy."
        # ci/env.sh prefers .venv soldr over PATH, so a stale local copy from
        # an earlier ./install would shadow the system soldr. Remove it.
        if (( ! GLOBAL )) && [[ -e "$target_dir/$binary" ]]; then
            if (( DRY_RUN )); then
                echo "Would remove stale local copy $target_dir/$binary"
            else
                rm -f "$target_dir/$binary"
                echo "Removed stale local copy $target_dir/$binary"
            fi
        fi
        exit 0
    fi
    VERSION="$(resolve_latest)" || exit 1
    echo "Resolved latest soldr release: ${VERSION}"
fi

# Current soldr releases ship `.tar.zst` archives, which need a `zstd` binary
# this script cannot assume (git-bash on Windows has GNU tar but no zstd). The
# release's wheel is a plain zip carrying the same binary under
# `soldr-<version>.data/scripts/`, so install from the wheel. Old releases
# published no wheels, only `.tar.gz`/`.zip`; fall back to those only when the
# wheel is a 404, so a network/TLS/server failure is reported as such.
case "$uname_s" in
    Linux*)  wheel_tag="manylinux_2_17_${arch}.manylinux2014_${arch}" ;;
    Darwin*) if [[ "$arch" == "aarch64" ]]; then wheel_tag="macosx_11_0_arm64"; else wheel_tag="macosx_10_12_x86_64"; fi ;;
    *)       if [[ "$arch" == "aarch64" ]]; then wheel_tag="win_arm64"; else wheel_tag="win_amd64"; fi ;;
esac

release="https://github.com/zackees/soldr/releases/download/v${VERSION}"
wheel_asset="soldr-${VERSION}-py3-none-${wheel_tag}.whl"
legacy_asset="soldr-v${VERSION}-${triple}.${ext}"

if (( DRY_RUN )); then
    echo "Would install soldr ${VERSION} from ${release}/${wheel_asset} -> $target_dir/$binary"
    exit 0
fi

mkdir -p "$target_dir"

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

unzip_to_tmp() {
    local py
    if command -v unzip >/dev/null 2>&1; then
        unzip -q "$1" -d "$tmp"
        return
    fi
    py="$(command -v python3 2>/dev/null || command -v python 2>/dev/null || true)"
    if [[ -z "$py" ]]; then
        echo "cannot extract $1: install unzip or Python 3" >&2
        return 1
    fi
    "$py" -c "import zipfile,sys; zipfile.ZipFile(sys.argv[1]).extractall(sys.argv[2])" "$1" "$tmp"
}

echo "Downloading ${release}/${wheel_asset}"
status=$(curl -sSL -w '%{http_code}' -o "$tmp/$wheel_asset" "${release}/${wheel_asset}") || {
    echo "error: download of ${release}/${wheel_asset} failed" >&2
    exit 1
}
if [[ "$status" == 200 ]]; then
    unzip_to_tmp "$tmp/$wheel_asset"
elif [[ "$status" == 404 ]]; then
    echo "No wheel for soldr ${VERSION}; downloading legacy archive ${release}/${legacy_asset}"
    curl -fSL "${release}/${legacy_asset}" -o "$tmp/$legacy_asset"
    if [[ "$ext" == "zip" ]]; then
        unzip_to_tmp "$tmp/$legacy_asset"
    else
        tar -xzf "$tmp/$legacy_asset" -C "$tmp"
    fi
else
    echo "error: ${release}/${wheel_asset} returned HTTP $status" >&2
    exit 1
fi

src=$(find "$tmp" -type f -name "$binary" | head -n1)
if [[ -z "$src" ]]; then
    echo "binary $binary not found in the soldr v${VERSION} download" >&2
    exit 1
fi

cp "$src" "$target_dir/$binary"
chmod +x "$target_dir/$binary"
echo "Installed soldr ${VERSION} -> $target_dir/$binary"
"$target_dir/$binary" --version
